# ============================================================
# .env.example — Diego Santos Portfolio
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais.
# ============================================================

# AMBIENTE
# development | production
NODE_ENV=development

# SERVIDOR EXPRESS
# Porta onde o servidor de produção vai rodar
PORT=3000

# VITE — BASE PATH
# Para deploy em subdiretório (ex: GitHub Pages: /diego-santos-portfolio/)
# Deixe "/" para deploy na raiz (Vercel, Netlify, domínio próprio)
VITE_BASE_PATH=/

# GOOGLE MAPS API
# Necessário apenas se o componente Map.tsx estiver ativo
# Obter em: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=
